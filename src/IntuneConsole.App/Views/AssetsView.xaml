<UserControl x:Class="IntuneConsole.App.Views.AssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
                <Button x:Name="AddMissingButton" Content="Add missing devices" Click="AddMissing_Click" Margin="0,0,8,0"
                        ToolTip="Create a record for every Intune device that isn't in the register yet"/>
                <Button x:Name="WarrantyButton" Content="Update warranties" Click="Warranty_Click" Margin="0,0,8,0"
                        ToolTip="Look up Dell warranty for records that are missing it or haven't been checked for 30 days"/>
                <Button Content="Add asset…" Click="AddAsset_Click" Margin="0,0,8,0"
                        ToolTip="Add a device that isn't in Intune, e.g. a spare on the shelf"/>
                <Button Content="Import CSV…" Click="Import_Click" Margin="0,0,8,0"/>
                <Button Content="Export CSV" Click="Export_Click"/>
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="Assets" Style="{StaticResource H1}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Loading…"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="In register" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiTotal" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Not in register yet" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiMissing" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource WarnFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="In stock" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiStock" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Warranty ends in 90 days" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiWarranty" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource WarnFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Assignment differs from Intune" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiDiffers" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource ErrorFg}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" TextChanged="Search_TextChanged"
                     ToolTip="Filter by serial, asset tag, device, model, person, location, PO or notes" AutomationProperties.Name="Filter assets"/>
            <TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
            <ComboBox x:Name="ReportCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="Report_Changed" AutomationProperties.Name="Report"/>
            <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="AssetGrid" MouseDoubleClick="AssetGrid_MouseDoubleClick" PreviewKeyDown="AssetGrid_PreviewKeyDown"
                          AutomationProperties.Name="Assets">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SERIAL" Binding="{Binding SerialNumber}" Width="100" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="ASSET TAG" Binding="{Binding AssetTag}" Width="90"/>
                        <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Tag="{Binding StatusTone}">
                                        <TextBlock Text="{Binding Row.Status}" Style="{StaticResource PillText}"
                                                   Foreground="{Binding StatusTone, Converter={StaticResource PillFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DEVICE" Binding="{Binding Row.DeviceName}" Width="130"/>
                        <DataGridTextColumn Header="MODEL" Binding="{Binding Row.Model}" Width="140"/>
                        <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding Row.AssignedName}" Width="150"/>
                        <DataGridTextColumn Header="INTUNE USER" Binding="{Binding Row.IntuneUser}" Width="140"/>
                        <DataGridTextColumn Header="WARRANTY" Binding="{Binding Row.WarrantyText}" Width="140" SortMemberPath="Row.WarrantyEnd"/>
                        <DataGridTextColumn Header="AGE" Binding="{Binding Row.AgeText}" Width="60" SortMemberPath="Row.AgeYears"/>
                        <DataGridTextColumn Header="LAST SEEN" Binding="{Binding Row.LastSeen}" Width="110"/>
                        <DataGridTextColumn Header="ATTENTION" Binding="{Binding Row.Flag}" Width="*" Foreground="{StaticResource WarnFg}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="SetupPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Visibility="Collapsed">
                    <TextBlock Text="Set up the asset register" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                               Text="Asset records live in a SharePoint list so every admin sees the same register. A SharePoint admin runs scripts\sharepoint\Setup-AssetRegister.ps1 once, then you enter the site URL in Settings. See the README, section 7."/>
                    <Button Content="Open Settings" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OpenSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
