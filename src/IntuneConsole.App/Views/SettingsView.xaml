<UserControl x:Class="IntuneConsole.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20"
                       Text="Saved for your Windows account only. Keys and tokens go into Windows Credential Manager, not a file."/>

            <Border x:Name="FirstRunBanner" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,20" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Welcome. " FontWeight="SemiBold"/>
                    <Run Text="Enter the tenant and app registration IDs from the setup guide to sign in. Datto and the file drop are optional and can be added later."/>
                </TextBlock>
            </Border>

            <!-- Sign-in -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Microsoft sign-in" Style="{StaticResource H2}"/>
                    <TextBlock Text="Tenant ID or primary domain" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TenantBox" AutomationProperties.Name="Tenant ID"/>
                    <TextBlock Text="Application (client) ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ClientBox" AutomationProperties.Name="Application client ID"/>
                    <TextBlock Style="{StaticResource Hint}" Text="From the Entra app registration you created in the setup guide. Admins sign in with their own accounts; your Intune role still decides what you can do."/>
                </StackPanel>
            </Border>

            <!-- Datto -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Datto RMM" Style="{StaticResource H2}"/>
                    <TextBlock Text="API URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DattoUrlBox" AutomationProperties.Name="Datto API URL"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Shown on your user page in Datto after generating API keys, e.g. https://merlot-api.centrastage.net"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Your API key" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="DattoKeyBox" AutomationProperties.Name="Datto API key"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Your API secret" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="DattoSecretBox" AutomationProperties.Name="Datto API secret"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DattoSavedHint" Style="{StaticResource Hint}"/>

                    <TextBlock Text="Component names (as imported into Datto)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Restart IME" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CompRestartBox" Margin="0,4" AutomationProperties.Name="Restart IME component"/>
                        <TextBlock Grid.Row="1" Text="Clear IME cache" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompCacheBox" Margin="0,4" AutomationProperties.Name="Clear cache component"/>
                        <TextBlock Grid.Row="2" Text="Reset Win32 app" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CompResetBox" Margin="0,4" AutomationProperties.Name="Reset app component"/>
                        <TextBlock Grid.Row="3" Text="Push file" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CompPushBox" Margin="0,4" AutomationProperties.Name="Push file component"/>
                        <TextBlock Grid.Row="4" Text="Run PowerShell" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="CompPsBox" Margin="0,4" AutomationProperties.Name="Run PowerShell component"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test Datto connection" Click="TestDatto_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="DattoTestResult" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Asset register -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Asset register" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="SharePoint lists that hold asset records, shared by all admins. Run scripts\sharepoint\Setup-AssetRegister.ps1 once to create them."/>
                    <TextBlock Text="SharePoint site URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AssetSiteBox" AutomationProperties.Name="SharePoint site URL"/>
                    <TextBlock Style="{StaticResource Hint}" Text="e.g. https://contoso.sharepoint.com/sites/IT"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Assets list name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AssetsListBox" AutomationProperties.Name="Assets list name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="History list name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HistoryListBox" AutomationProperties.Name="History list name"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Organization name (printed on handover sheets)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="OrgNameBox" AutomationProperties.Name="Organization name"/>

                    <TextBlock Text="Dell warranty (TechDirect API)" Style="{StaticResource H2}" Margin="0,20,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DellIdBox" AutomationProperties.Name="Dell client ID"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Client secret" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="DellSecretBox" AutomationProperties.Name="Dell client secret"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DellSavedHint" Style="{StaticResource Hint}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test asset register" Click="TestAssets_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AssetTestResult" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- File drop -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="File drop (for pushing files)" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="An Azure Blob container that hands files to the Datto push component. Optional: only needed for Push file."/>
                    <TextBlock Text="Container URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DropUrlBox" AutomationProperties.Name="File drop container URL"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Upload SAS token (create, write, delete)" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="UploadSasBox" AutomationProperties.Name="Upload SAS token"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Download SAS token (read only)" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="ReadSasBox" AutomationProperties.Name="Download SAS token"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DropSavedHint" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <!-- Other -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Other" Style="{StaticResource H2}"/>
                    <TextBlock Text="Treat a device as stale after this many days without check-in" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StaleDaysBox" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="Stale days"/>
                    <TextBlock Text="Diagnostics download folder (blank = default)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DiagFolderBox" AutomationProperties.Name="Diagnostics folder"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="120" HorizontalContentAlignment="Center" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
