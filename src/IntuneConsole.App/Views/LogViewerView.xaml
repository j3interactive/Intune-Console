<UserControl x:Class="IntuneConsole.App.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open a bundle (.zip)…" Click="OpenZip_Click"/>
                <Button x:Name="OpenFolderButton" Content="Open folder" Margin="8,0,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Diagnostics" Style="{StaticResource H1}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="Collect diagnostics from a device page, or open a bundle you downloaded from Intune."/>
            </StackPanel>
        </DockPanel>

        <!-- Likely causes -->
        <ItemsControl x:Name="FindingsList" Grid.Row="1" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFF8EB" BorderBrush="#F0D3A1" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Show in log" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Tag="{Binding}" Click="ShowEvidence_Click"/>
                            <StackPanel>
                                <TextBlock Text="LIKELY CAUSE · PATTERN MATCH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarnFg}"/>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#3D444D"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                                    <Run Text="Next step: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding NextStep, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding EvidenceText}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Files -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <ListBox x:Name="FileList" BorderThickness="0" SelectionChanged="FileList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Files in bundle">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                               Margin="6,12,6,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,4" ToolTip="{Binding Folder}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{Binding Badge, Converter={StaticResource PillFg}}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Lines -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,12">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <RadioButton x:Name="LevelErrors" Style="{StaticResource Chip}" GroupName="Level" Content="Errors" Checked="Level_Changed"/>
                                <RadioButton x:Name="LevelWarnings" Style="{StaticResource Chip}" GroupName="Level" Content="Warnings + errors" Checked="Level_Changed"/>
                                <RadioButton x:Name="LevelAll" Style="{StaticResource Chip}" GroupName="Level" Content="All" IsChecked="True" Checked="Level_Changed"/>
                            </WrapPanel>
                            <TextBox x:Name="FilterBox" Margin="0,0,12,0" TextChanged="FilterBox_TextChanged"
                                     ToolTip="Filter lines (text, app ID, error code)" AutomationProperties.Name="Filter log lines"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="LinesGrid" Grid.Row="1" RowHeight="30" FontFamily="Consolas" FontSize="12.5"
                              SelectionChanged="LinesGrid_SelectionChanged" AutomationProperties.Name="Log lines"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter Property="Background" Value="#FDF1EF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                        <Setter Property="Background" Value="#FFF8EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="120"/>
                            <DataGridTemplateColumn Header="LEVEL" Width="70" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold"
                                                   Foreground="{Binding LevelText, Converter={StaticResource PillFg}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="150"/>
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="ExternalPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ExternalText" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,0,0,12" MaxWidth="420"/>
                        <Button Content="Open with default app" HorizontalAlignment="Center" Click="OpenExternal_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock x:Name="CodeHint" TextWrapping="Wrap" Foreground="{StaticResource WarnFg}" FontWeight="Medium"
                                       Margin="0,0,0,6" Visibility="Collapsed"/>
                            <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5"
                                     Height="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     BorderThickness="0" Background="#F8F9FA" AutomationProperties.Name="Selected line"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
