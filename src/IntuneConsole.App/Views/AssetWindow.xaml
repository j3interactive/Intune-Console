<Window x:Class="IntuneConsole.App.Views.AssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Background="{StaticResource Page}" Foreground="{StaticResource Ink}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="CheckOutButton" Content="Assign / check out…" Click="CheckOut_Click" Margin="0,0,8,0"/>
                <Button x:Name="CheckInButton" Content="Check in…" Click="CheckIn_Click" Margin="0,0,8,0"/>
                <Button x:Name="PrintButton" Content="Print handover sheet" Click="Print_Click" Margin="0,0,8,0"/>
                <Button x:Name="OpenDeviceButton" Content="Open device" Click="OpenDevice_Click"/>
            </WrapPanel>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{StaticResource H1}" FontSize="22"/>
                <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Fields -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Serial number (service tag)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SerialBox" FontFamily="Consolas" CharacterCasing="Upper" AutomationProperties.Name="Serial number"/>
                            <TextBlock Text="Asset tag" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TagBox" AutomationProperties.Name="Asset tag"/>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="StatusCombo" AutomationProperties.Name="Status"/>
                            <TextBlock Text="Assigned to (UPN)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AssignedToBox" AutomationProperties.Name="Assigned to"/>
                            <TextBlock Text="Assigned name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AssignedNameBox" AutomationProperties.Name="Assigned name"/>
                            <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LocationBox" AutomationProperties.Name="Location"/>
                            <TextBlock Text="Cost center" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CostCenterBox" AutomationProperties.Name="Cost center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModelBox" AutomationProperties.Name="Model"/>
                            <TextBlock Text="Purchase date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="PurchaseDatePicker" AutomationProperties.Name="Purchase date"/>
                            <TextBlock Text="Cost" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CostBox" AutomationProperties.Name="Cost"/>
                            <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SupplierBox" AutomationProperties.Name="Supplier"/>
                            <TextBlock Text="PO number" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PoBox" AutomationProperties.Name="PO number"/>
                            <TextBlock Text="Warranty (Dell)" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button x:Name="WarrantyButton" DockPanel.Dock="Right" Content="Look up" Click="Warranty_Click" Margin="8,0,0,0"/>
                                <TextBlock x:Name="WarrantyText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Notes"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Live data + history -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="In Intune now" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LiveText" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource H2}" Margin="20,16,20,8"/>
                        <ListBox x:Name="HistoryList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8"
                                 AutomationProperties.Name="Asset history">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock>
                                            <Run Text="{Binding WhenText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Event, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ChangeText}" TextWrapping="Wrap"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}">
                                            <Run Text="{Binding By, Mode=OneWay}"/>
                                            <Run Text="{Binding Notes, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="100" HorizontalContentAlignment="Center" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    HorizontalContentAlignment="Center" Margin="0,0,8,0" Click="Save_Click"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource ErrorFg}"/>
        </DockPanel>
    </Grid>
</Window>
