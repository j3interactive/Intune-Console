<Window x:Class="IntuneConsole.App.Views.BulkActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk action" Width="1000" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Background="{StaticResource Page}" Foreground="{StaticResource Ink}"
        Closing="OnClosing">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: targets and action -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Bulk action" Style="{StaticResource H1}" FontSize="22"/>
                <TextBlock Text="Devices: one per line, by name or serial number. Selected devices are filled in for you."
                           Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="Action" FontWeight="Medium" Margin="0,0,0,4"/>
                <ComboBox x:Name="ActionCombo" SelectionChanged="ActionCombo_SelectionChanged" AutomationProperties.Name="Action"/>
                <StackPanel x:Name="RemediationPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Remediation" FontWeight="Medium" Margin="0,0,0,4"/>
                    <ComboBox x:Name="RemediationCombo" AutomationProperties.Name="Remediation"/>
                </StackPanel>
                <TextBlock x:Name="ActionHint" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="RunButton" Content="Run" Style="{StaticResource PrimaryButton}" MinWidth="110"
                            HorizontalContentAlignment="Center" Click="Run_Click"/>
                    <Button x:Name="CancelButton" Content="Stop" Margin="8,0,0,0" MinWidth="90" HorizontalContentAlignment="Center"
                            Click="Cancel_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>

            <TextBox x:Name="TargetsBox" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top"
                     TextChanged="TargetsBox_TextChanged" AutomationProperties.Name="Device names or serial numbers"/>
        </DockPanel>

        <!-- Right: resolved devices and results -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="MatchText" FontWeight="SemiBold" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="UnmatchedText" DockPanel.Dock="Top" Foreground="{StaticResource WarnFg}" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="Collapsed"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="ResultsGrid" AutomationProperties.Name="Bulk results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DEVICE" Binding="{Binding Device.DeviceName}" Width="160"/>
                        <DataGridTextColumn Header="USER" Binding="{Binding Device.UserDisplayName}" Width="150"/>
                        <DataGridTextColumn Header="DATTO" Binding="{Binding Device.DattoStatusText}" Width="100"/>
                        <DataGridTemplateColumn Header="RESULT" Width="110" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Tag="{Binding State}">
                                        <TextBlock Text="{Binding State}" Style="{StaticResource PillText}"
                                                   Foreground="{Binding State, Converter={StaticResource PillFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
