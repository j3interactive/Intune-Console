<UserControl x:Class="IntuneConsole.App.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="← Devices" Style="{StaticResource LinkButton}" Click="Back_Click"/>
                <TextBlock x:Name="CrumbText" Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Summary -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Style="{StaticResource H1}" Margin="0,0,14,0"/>
                        <Border x:Name="CompliancePill" Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <TextBlock x:Name="ComplianceText" Style="{StaticResource PillText}"/>
                        </Border>
                        <Border x:Name="DattoPill" Style="{StaticResource Pill}">
                            <TextBlock x:Name="DattoText" Style="{StaticResource PillText}"/>
                        </Border>
                    </WrapPanel>
                    <WrapPanel x:Name="InfoPanel" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Intune actions" Style="{StaticResource H2}"/>
                        <TextBlock Text="Via Microsoft Graph · applies at the device's next check-in" Style="{StaticResource Label}" Margin="0,2,0,12"/>
                        <Button Content="Sync now" Click="Sync_Click" Margin="0,0,0,8"/>
                        <Button x:Name="CollectButton" Content="Collect diagnostics" Style="{StaticResource PrimaryButton}"
                                Click="Collect_Click" Margin="0,0,0,8"/>
                        <Button x:Name="OpenDiagButton" Content="Open latest diagnostics" Click="OpenDiag_Click"
                                Margin="0,0,0,8" IsEnabled="False"/>
                        <Button Content="Restart device…" Click="Reboot_Click"/>
                        <TextBlock x:Name="DiagStatusText" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                   Text="Checking for earlier diagnostics…"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Fix-it scripts" Style="{StaticResource H2}"/>
                        <TextBlock Text="Intune Remediation, run on demand · usually 5–15 min" Style="{StaticResource Label}" Margin="0,2,0,12"/>
                        <ComboBox x:Name="RemediationCombo" AutomationProperties.Name="Remediation script" Margin="0,0,0,8"/>
                        <Button Content="Run on this device" Click="RunRemediation_Click" Margin="0,0,0,12"/>
                        <TextBlock x:Name="RemediationNote" Style="{StaticResource MutedText}"
                                   Text="Lists the Remediations in your tenant. The setup guide has ready-made ones for restarting the Intune Management Extension and clearing its cache."/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" BorderBrush="#C9BEEB">
                    <StackPanel>
                        <TextBlock Text="Datto RMM" Style="{StaticResource H2}"/>
                        <TextBlock Text="Instant · runs a Datto component on the agent" Style="{StaticResource Label}"
                                   Foreground="{StaticResource DattoBrush}" Margin="0,2,0,12"/>
                        <StackPanel x:Name="DattoActions">
                            <Button Content="Restart IME service now" Style="{StaticResource DattoButton}" Click="DattoRestartIme_Click" Margin="0,0,0,8"/>
                            <Button Content="Clear IME download cache" Click="DattoClearCache_Click" Margin="0,0,0,8"/>
                            <Button Content="Reset selected app's install state…" Click="DattoResetApp_Click" Margin="0,0,0,8"/>
                            <Button x:Name="OpenDattoButton" Content="Open device in Datto ↗" Click="OpenDatto_Click" Margin="0,0,0,8"/>
                            <Button x:Name="WebRemoteButton" Content="Start web remote ↗" Click="WebRemote_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="DattoNote" Style="{StaticResource MutedText}" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Issues + push file -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="20,16">
                                <TextBlock x:Name="AppsSummary" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <TextBlock Text="Apps" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <DataGrid x:Name="AppsGrid" RowHeight="NaN" MinRowHeight="38" MaxHeight="420"
                                      AutomationProperties.Name="App install status">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="APP" Binding="{Binding AppName}" Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="120" SortMemberPath="InstallState">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pill}" Tag="{Binding InstallState}">
                                                    <TextBlock Text="{Binding InstallState}" Style="{StaticResource PillText}"
                                                               Foreground="{Binding InstallState, Converter={StaticResource PillFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ERROR" Binding="{Binding HexErrorCode}" Width="110" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="WHAT IT MEANS" Binding="{Binding Explanation}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Margin" Value="0,8"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="20,16">
                                <CheckBox x:Name="ShowAllPolicies" DockPanel.Dock="Right" Content="Show all" VerticalAlignment="Center"
                                          Checked="ShowAllPolicies_Changed" Unchecked="ShowAllPolicies_Changed"/>
                                <TextBlock Text="Policy problems" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <DataGrid x:Name="PolicyGrid" RowHeight="NaN" MinRowHeight="38" MaxHeight="360"
                                      AutomationProperties.Name="Policy states">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="110"/>
                                    <DataGridTextColumn Header="POLICY" Binding="{Binding DisplayName}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="STATE" Width="120" SortMemberPath="State">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pill}" Tag="{Binding State}">
                                                    <TextBlock Text="{Binding State}" Style="{StaticResource PillText}"
                                                               Foreground="{Binding State, Converter={StaticResource PillFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="WHAT IT MEANS" Binding="{Binding Explanation}" Width="3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Margin" Value="0,8"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PolicyEmpty" Text="No policy conflicts or errors on this device." Style="{StaticResource MutedText}"
                                       Margin="20,0,20,16" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Recent actions on this device (this session)" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ActionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding WhenText}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{StaticResource Muted}" Width="96"/>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Action, Mode=OneWay}" FontWeight="Medium"/>
                                                <Run Text=" · via " Foreground="{StaticResource Muted}"/>
                                                <Run Text="{Binding Via, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                                <Run Text=" · " Foreground="{StaticResource Muted}"/>
                                                <Run Text="{Binding Outcome, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Intune's and Datto's own audit logs keep the full record of who did what."
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Push file -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Push a file" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Text="Delivered by Datto right away. The device must be online in Datto."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

                        <TextBlock Text="File" FontWeight="Medium" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="PushFilePath" AutomationProperties.Name="File to push"/>
                        </DockPanel>

                        <TextBlock Text="Destination folder on the device" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox x:Name="PushDestination" Text="C:\ProgramData\" FontFamily="Consolas" Margin="0,0,0,12"
                                 AutomationProperties.Name="Destination folder"/>

                        <CheckBox x:Name="PushOverwrite" Content="Overwrite if the file already exists" IsChecked="True" Margin="0,0,0,16"/>

                        <Button Content="Push file" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center"
                                Click="Push_Click"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="The file is staged in your file drop container and checked with a SHA-256 hash on the device before it's saved."/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
