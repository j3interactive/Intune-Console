<UserControl x:Class="IntuneConsole.App.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="300" TextChanged="Search_TextChanged"
                         ToolTip="Filter by device, user, UPN, serial, model or MAC address"
                         AutomationProperties.Name="Search devices"/>
                <Button Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
                <Button Content="Bulk action…" Margin="8,0,0,0" Click="Bulk_Click"
                        ToolTip="Run one action on the selected devices (Ctrl/Shift-click to select several), or paste a list"/>
                <Button Content="Export CSV" Margin="8,0,0,0" Click="Export_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource H1}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Loading…"/>
            </StackPanel>
        </DockPanel>

        <!-- KPI tiles -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Windows devices" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiTotal" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Noncompliant" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiNoncompliant" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource ErrorFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="KpiStaleLabel" Text="No check-in 7+ days" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiStale" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource WarnFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Not encrypted" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiUnencrypted" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource WarnFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Datto offline / missing" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="KpiDatto" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Device table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                    <DockPanel>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <WrapPanel>
                            <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="Filter" IsChecked="True"
                                         Content="All" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterNoncompliant" Style="{StaticResource Chip}" GroupName="Filter"
                                         Content="Noncompliant" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterStale" Style="{StaticResource Chip}" GroupName="Filter"
                                         Content="Stale" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterUnencrypted" Style="{StaticResource Chip}" GroupName="Filter"
                                         Content="Not encrypted" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterDattoOffline" Style="{StaticResource Chip}" GroupName="Filter"
                                         Content="Datto offline" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterNotInDatto" Style="{StaticResource Chip}" GroupName="Filter"
                                         Content="Not in Datto" Checked="Filter_Changed"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="DeviceGrid" SelectionMode="Extended" MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown"
                          AutomationProperties.Name="Devices">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="DEVICE" Width="170" SortMemberPath="DeviceName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PRIMARY USER" Binding="{Binding UserDisplayName}" Width="170"/>
                        <DataGridTextColumn Header="OS VERSION" Binding="{Binding OsVersion}" Width="130"/>
                        <DataGridTemplateColumn Header="COMPLIANCE" Width="140" SortMemberPath="ComplianceText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Tag="{Binding ComplianceText}">
                                        <TextBlock Text="{Binding ComplianceText}" Style="{StaticResource PillText}"
                                                   Foreground="{Binding ComplianceText, Converter={StaticResource PillFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="LAST CHECK-IN" Binding="{Binding LastSyncText}" Width="120"
                                            SortMemberPath="LastSyncDateTime"/>
                        <DataGridTextColumn Header="MODEL" Binding="{Binding Model}" Width="*"/>
                        <DataGridTemplateColumn Header="DATTO AGENT" Width="130" SortMemberPath="DattoStatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Tag="{Binding DattoStatusText}">
                                        <TextBlock Text="{Binding DattoStatusText}" Style="{StaticResource PillText}"
                                                   Foreground="{Binding DattoStatusText, Converter={StaticResource PillFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
