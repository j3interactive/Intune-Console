<UserControl x:Class="IntuneConsole.App.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="← Devices" Style="{StaticResource LinkButton}" Click="Back_Click"/>
                <TextBlock x:Name="CrumbText" Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Person -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Copy UPN" Click="CopyUpn_Click"/>
                            <Button Content="Open in Entra ↗" Margin="8,0,0,0" Click="OpenEntra_Click"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentSoft}" Margin="0,0,14,0">
                                <TextBlock x:Name="InitialsText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <WrapPanel>
                                    <TextBlock x:Name="NameText" Style="{StaticResource H1}" Margin="0,0,12,0"/>
                                    <Border x:Name="AccountPill" Style="{StaticResource Pill}">
                                        <TextBlock x:Name="AccountText" Style="{StaticResource PillText}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="TitleText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                    <WrapPanel x:Name="InfoPanel" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="20,16">
                        <TextBlock x:Name="DevicesSummary" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Devices" Style="{StaticResource H2}"/>
                            <TextBlock Text="Where they're the Intune primary user, plus devices they signed in to in the last 14 days. Double-click to troubleshoot."
                                       Style="{StaticResource Label}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="DevicesGrid" MouseDoubleClick="DevicesGrid_MouseDoubleClick" PreviewKeyDown="DevicesGrid_PreviewKeyDown"
                              AutomationProperties.Name="User's devices">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="DEVICE" Width="170" SortMemberPath="Device.DeviceName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Device.DeviceName}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="RELATIONSHIP" Binding="{Binding Relationship}" Width="220"/>
                            <DataGridTextColumn Header="OS" Binding="{Binding Device.OperatingSystem}" Width="90"/>
                            <DataGridTextColumn Header="MODEL" Binding="{Binding Device.Model}" Width="*"/>
                            <DataGridTemplateColumn Header="COMPLIANCE" Width="140" SortMemberPath="Device.ComplianceText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Tag="{Binding Device.ComplianceText}">
                                            <TextBlock Text="{Binding Device.ComplianceText}" Style="{StaticResource PillText}"
                                                       Foreground="{Binding Device.ComplianceText, Converter={StaticResource PillFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LAST CHECK-IN" Binding="{Binding Device.LastSyncText}" Width="110"/>
                            <DataGridTextColumn Header="LAST SIGN-IN" Binding="{Binding LastSignInText}" Width="110"/>
                            <DataGridTemplateColumn Header="DATTO" Width="120" SortMemberPath="Device.DattoStatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Tag="{Binding Device.DattoStatusText}">
                                            <TextBlock Text="{Binding Device.DattoStatusText}" Style="{StaticResource PillText}"
                                                       Foreground="{Binding Device.DattoStatusText, Converter={StaticResource PillFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DevicesEmpty" Style="{StaticResource MutedText}" Margin="20,0,20,16" Visibility="Collapsed"
                               Text="No Intune devices found for this person."/>
                </StackPanel>
            </Border>

            <!-- Sign-ins -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <DockPanel Margin="20,16">
                        <CheckBox x:Name="FailuresOnly" DockPanel.Dock="Right" Content="Failures only" VerticalAlignment="Center"
                                  Checked="FailuresOnly_Changed" Unchecked="FailuresOnly_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Recent sign-ins" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="SignInSummary" Text="Last 14 days" Style="{StaticResource Label}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="SignInGrid" RowHeight="NaN" MinRowHeight="36" MaxHeight="460" AutomationProperties.Name="Recent sign-ins">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="WHEN" Binding="{Binding WhenText}" Width="110" SortMemberPath="When"/>
                            <DataGridTemplateColumn Header="RESULT" Width="130" SortMemberPath="ErrorCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Tag="{Binding ResultText}">
                                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource PillText}"
                                                       Foreground="{Binding ResultText, Converter={StaticResource PillFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="APP" Binding="{Binding App}" Width="170"/>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceText}" Width="150"/>
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding LocationText}" Width="140"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Margin" Value="0,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SignInNote" Style="{StaticResource MutedText}" Margin="20,8,20,16" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
