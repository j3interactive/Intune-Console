<Window x:Class="IntuneConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intune Troubleshooting Console"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Ink}" Background="{StaticResource Page}">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" Padding="16,24">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Path Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" Stroke="#6CB4F5" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                    <TextBlock Text="Endpoint Console" Foreground="#E6E9ED" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <RadioButton x:Name="NavDevices" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Devices" Click="NavDevices_Click"/>
                <RadioButton x:Name="NavDiagnostics" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Diagnostics" Click="NavDiagnostics_Click"/>
                <RadioButton x:Name="NavHealth" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Record health check" Click="NavHealth_Click"/>
                <RadioButton x:Name="NavSettings" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Settings" Click="NavSettings_Click"/>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{StaticResource SidebarActive}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SignedInText" Text="Not signed in" Foreground="#A9B1BB" FontSize="12"
                               TextWrapping="Wrap" Margin="8,0,8,8"/>
                    <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" Margin="8,0"
                            Foreground="#C3C9D1" Background="Transparent" BorderBrush="{StaticResource SidebarActive}"
                            HorizontalAlignment="Left" MinHeight="32"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Global search: people and devices -->
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1" Padding="32,12">
                <Grid HorizontalAlignment="Left" Width="560">
                    <TextBox x:Name="GlobalSearch" Padding="34,6,8,6" TextChanged="GlobalSearch_TextChanged"
                             PreviewKeyDown="GlobalSearch_PreviewKeyDown" LostKeyboardFocus="GlobalSearch_LostFocus"
                             GotKeyboardFocus="GlobalSearch_GotFocus"
                             AutomationProperties.Name="Search people and devices"
                             ToolTip="Search people by name, UPN, email, employee ID, title or department, and devices by name, serial or MAC (Ctrl+K)"/>
                    <Path Data="M10,3 A7,7 0 1 1 9.99,3 Z M15,15 L21,21" Stroke="{StaticResource Muted}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Search people or devices…   Ctrl+K" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>

                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=GlobalSearch}" Placement="Bottom"
                           StaysOpen="True" AllowsTransparency="True" Width="560">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Margin="0,4,0,0" Padding="6">
                            <StackPanel>
                                <ListBox x:Name="SearchResults" BorderThickness="0" MaxHeight="440"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="SearchResults_PreviewKeyDown" MouseUp="SearchResults_MouseUp"
                                         AutomationProperties.Name="Search results">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="4,6">
                                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                                                        Background="{Binding Kind, Converter={StaticResource KindBg}}">
                                                    <TextBlock Text="{Binding Kind, Converter={StaticResource KindGlyph}}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Accent}"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Label}"
                                                           VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SearchStatus" Style="{StaticResource MutedText}" Margin="8,6"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <ProgressBar x:Name="BusyBar" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/>

            <ContentControl x:Name="ContentHost" Grid.Row="2" Focusable="False"/>

            <Border x:Name="StatusBar" Grid.Row="3" Padding="20,10" Visibility="Collapsed"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource LinkButton}"
                            Click="DismissStatus_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
