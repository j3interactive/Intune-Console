<Window x:Class="IntuneConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intune Troubleshooting Console"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Ink}" Background="{StaticResource Page}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" Padding="16,24">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Path Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" Stroke="#6CB4F5" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                    <TextBlock Text="Endpoint Console" Foreground="#E6E9ED" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <RadioButton x:Name="NavDevices" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Devices" Click="NavDevices_Click"/>
                <RadioButton x:Name="NavDiagnostics" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Diagnostics" Click="NavDiagnostics_Click"/>
                <RadioButton x:Name="NavSettings" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                             GroupName="Nav" Content="Settings" Click="NavSettings_Click"/>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{StaticResource SidebarActive}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SignedInText" Text="Not signed in" Foreground="#A9B1BB" FontSize="12"
                               TextWrapping="Wrap" Margin="8,0,8,8"/>
                    <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" Margin="8,0"
                            Foreground="#C3C9D1" Background="Transparent" BorderBrush="{StaticResource SidebarActive}"
                            HorizontalAlignment="Left" MinHeight="32"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="BusyBar" Grid.Row="0" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/>

            <ContentControl x:Name="ContentHost" Grid.Row="1" Focusable="False"/>

            <Border x:Name="StatusBar" Grid.Row="2" Padding="20,10" Visibility="Collapsed"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource LinkButton}"
                            Click="DismissStatus_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
